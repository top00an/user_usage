# 사용량 대시보드 환경 변수 — 이 파일을 `.env` 로 복사해 채운다.
#
# 이 서비스는 프레임워크 없이 process.env 를 그대로 읽는다(.env 자동 로드 없음).
# 셸에서 넘기거나(`USAGE_ADMIN_TOKEN=… npm start`), docker compose 의 env_file 로 넣는다.


# ── 필수 ────────────────────────────────────────────────────────────────
# 조회 토큰. 최소 16자. 없으면 **부팅을 거부한다** — 이 화면은 사람별 사용량과 비용을 담고
# 있어서, 무인증으로 뜰 수 있는 경로를 남기지 않는다.
#   생성: openssl rand -hex 24
USAGE_ADMIN_TOKEN=


# ── 권장 ────────────────────────────────────────────────────────────────
# 보고 전용 토큰. 걸면 `POST /api/usage` **하나만** 열리고 조회는 403 이 된다.
#
# 왜 나누나: 인테이크의 보고자는 팀원 PC 마다 깔린 수집기다 — 이 토큰은 팀원 수만큼 복제되어
# 각자의 디스크에 놓인다. 그것이 곧 전원의 사용량·비용·머신명을 읽는 토큰이기도 하면 사본
# 하나만 새도 팀 전체가 열린다. 수집기에는 **이 토큰만** 배포하고, USAGE_ADMIN_TOKEN 은
# 대시보드를 여는 사람만 갖는다.
#
# 안 걸면 종전대로 USAGE_ADMIN_TOKEN 하나가 보고와 열람을 겸한다(하위호환).
# USAGE_ADMIN_TOKEN 과 같은 값이면 부팅을 거부한다 — 분리한 것처럼 보이지만 아무것도
# 분리되지 않은 상태이고, 그 착각이 이 레포에서 가장 비싼 사고 유형이다.
#   생성: openssl rand -hex 24
# USAGE_INTAKE_TOKEN=


# ── 네트워크 ────────────────────────────────────────────────────────────
# 포트(기본 4191). 브라우저가 차단하는 포트(4190·6000 등)를 지정하면 부팅에서 거부한다 —
# 서버는 뜨고 curl 도 통과하는데 브라우저에서만 아무것도 안 되는, 진단이 가장 어려운 모양이라서다.
# USAGE_PORT=4191

# 바인드 주소(기본 127.0.0.1 — 루프백). 토큰이 있어도 LAN 에 자동 노출하지 않는다.
# 컨테이너 안에서는 0.0.0.0 이 필요하다(Dockerfile 이 그 값을 기본으로 준다).
# USAGE_HOST=127.0.0.1


# ── 데이터 ──────────────────────────────────────────────────────────────
# local(기본)  로컬 sqlite. 인테이크까지 전부 뜬다.
# remote       DATABASE_URL 로 원격 PostgreSQL. **읽기 전용** — 인테이크·귀속 쓰기·보존 정리를
#              아예 등록하지 않는다("안 건드릴 것"을 규율이 아니라 배선으로 막는다).
# USAGE_DB_MODE=local

# local 모드의 sqlite 디렉터리(기본 <repo>/data). 파일명은 usage.db 로 고정된다.
# USAGE_DATA_DIR=./data

# remote 모드의 접속 문자열. SSH 터널을 뚫어 로컬 포트로 받는 것을 전제한다.
#   ssh -N -L 15432:<db-host>:5432 <user>@<your-host>
# ⚠ 반드시 **비-슈퍼·비-BYPASSRLS 앱 롤**로 붙는다. 슈퍼유저로 붙으면 RLS 테넌트 격리가
#   통째로 무력화되는데, 증상이 없다(요청은 200 이고 남의 데이터까지 잘 보인다).
#   서버가 부팅에서 이 롤을 **직접 확인하고 위반이면 거부한다**(경고문에 기대지 않는다).
#   DB 에 닿지 못해 확인이 불가능하면 거부하지 않되 stderr 로 크게 남긴다.
# DATABASE_URL=postgres://usage_app:<password>@127.0.0.1:15432/usage

# 조회 테넌트(기본 default). pg 백엔드에서 RLS 로 주입된다.
# USAGE_TENANT=default

# pg 커넥션 풀 상한(기본 10).
# USAGE_PG_POOL_MAX=10


# ── 보존 ────────────────────────────────────────────────────────────────
# 키워드 축 보존 일수(기본 90). 'off'·0 이면 정리기를 아예 띄우지 않는다(무기한 보관).
# 키워드만 기한을 두는 이유: 이 축만 사람이 입력한 말에서 나오고, 어휘가 무제한이라 행이 계속 는다.
# USAGE_KEYWORD_RETENTION_DAYS=90

# 정리 주기(시간, 기본 24).
# USAGE_RETENTION_INTERVAL_H=24


# ── 단가 ────────────────────────────────────────────────────────────────
# 비용 환산 단가를 덮어쓸 JSON 파일 경로(기본 <repo>/config.json).
# 형식은 config.example.json 참조. 단가는 실제로 바뀌므로 코드가 아니라 설정에서 고친다.
# USAGE_CONFIG=./config.json
