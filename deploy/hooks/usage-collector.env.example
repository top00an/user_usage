# usage-collector 설정 — 이 파일을 $HOME/.config/usage-collector.env 로 복사해 값을 채운다.
# SessionEnd 훅(session-end.sh)과 백그라운드 실행 양쪽이 이 값을 읽는다.

# SaaS 인제스트 엔드포인트(멀티테넌트 서버).
USAGE_SERVER_URL=https://usage.your-company.example.com

# org 인제스트 키. 운영자가 `usage-server key issue --org <org-id>` 로 발급한 값.
# ⚠ 이 키는 비밀이다 — 이 파일의 권한을 600 으로 두고, 저장소에 커밋하지 마라.
USAGE_INTAKE_TOKEN=uu_ing_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
